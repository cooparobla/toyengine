{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/claude_build_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking build safety"
          }
        ]
      }
    ]
  }
}
