#version 450

// The cloud march's detail volume (64^3, tiling, mip 0; SkyCloudPass bakes it once): inverted
// Worley fbm at three rising frequencies (r, g, b). The march erodes the base shape's edges with
// their fbm -- billows toward the top of a cloud, wisps toward its base.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image3D u_out;
layout(push_constant) uniform Gen { uint size; } gen;

#include "sky_cloud_noise_common.glsl"

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, ivec3(gen.size)))) return;
    vec3 uvw = (vec3(id) + 0.5) / float(gen.size);
    imageStore(u_out, id, vec4(cn_worley_fbm(uvw, 2, 71u), cn_worley_fbm(uvw, 4, 83u), cn_worley_fbm(uvw, 8, 97u), 1.0));
}
