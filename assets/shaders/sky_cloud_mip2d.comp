#version 450

// One mip of a cloud noise texture (CloudNoiseTexture): the box average of the 2x2 texels above.

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D u_src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D u_dst;

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, imageSize(u_dst)))) return;
    ivec2 s = id * 2;
    vec4 sum = imageLoad(u_src, s) + imageLoad(u_src, s + ivec2(1, 0)) + imageLoad(u_src, s + ivec2(0, 1))
             + imageLoad(u_src, s + ivec2(1, 1));
    imageStore(u_dst, id, sum * 0.25);
}
