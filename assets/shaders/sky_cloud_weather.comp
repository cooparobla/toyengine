#version 450

// The cloud layer's weather map (512 x 512, tiling, mip 0; SkyCloudPass bakes it once). The
// march reads it twice (at two scales, rotated) to place clouds across the sky:
//   r = the cloud field: Perlin fbm carved by inverted Worley cells, stretched to an even spread
//       over [0, 1], so a coverage of c covers about c of the sky
//   g = cloud type: 0 = flat stratus .. 0.5 = stratocumulus .. 1 = towering cumulus
//   b = very low-frequency fbm, varying coverage and base height across the sky
// The 2D noises are slices (z = 0) of 3D tiling noise, which tiles the same in x and y.

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D u_out;
layout(push_constant) uniform Gen { uint size; } gen;

#include "sky_cloud_noise_common.glsl"

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, ivec2(gen.size)))) return;
    vec3 uvw = vec3((vec2(id) + 0.5) / float(gen.size), 0.0);
    float perlin = cn_perlin_fbm(uvw, 6, 3, 5u);
    float worley = (0.625 * (1.0 - cn_worley(uvw * 8.0, 8, 7u)) + 0.25 * (1.0 - cn_worley(uvw * 16.0, 16, 11u))) / 0.875;
    float field = clamp(cn_remap(perlin, worley - 1.0, 1.0, 0.0, 1.0), 0.0, 1.0);
    field = clamp((field - 0.44) / 0.46, 0.0, 1.0);   // 5th..95th percentile -> [0, 1]: near-uniform
    float type = smoothstep(0.3, 0.7, cn_perlin_fbm(uvw, 3, 2, 13u));
    float variation = cn_perlin_fbm(uvw, 2, 3, 19u);
    imageStore(u_out, id, vec4(field, type, variation, 1.0));
}
