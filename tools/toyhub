#!/usr/bin/env bash
# toyhub -- create and manage toyengine projects from the command line (the GUI is
# build/toyengine_hub, which drives this same script).
#
#   toyhub new <dir> [ENGINE OPTIONS] [--no-setup]
#                                      create <dir> as a new project (named after the folder)
#   toyhub add <dir> [same options]    list a folder as a project; one without a .toy is set up
#                                      as a new project in place first (nothing is overwritten)
#   toyhub list [--porcelain]          listed projects (porcelain: name<TAB>path<TAB>engine)
#   toyhub forget <dir>                stop listing a project (its files stay)
#   toyhub delete <dir> [--yes]        move a project's folder to the Trash and stop listing it
#   toyhub build|run|editor|package <dir> [args...]   run that project's script
#                                      (package <dir> [dev|ship|assets] [out]: Build for this platform)
#   toyhub open <dir>                  build if needed, then launch the editor detached
#   toyhub rebuild <dir>               clean rebuild: remove build output, then build.sh
#   toyhub upgrade <dir> [--ref R]     move the project's own engine to another ref
#   toyhub link <dir> [ENGINE_DIR] [--force]
#                                      share a toyengine checkout (default: this one)
#   toyhub worktree <dir> [--branch B] [--ref R] [--path P] [--force]
#                                      give the project its OWN engine: a git worktree of this
#                                      checkout in <project>/engine, on its own branch
#   toyhub own <dir> [--ref R] [--branch B] [--path P] [--from-remote] [--force]
#                                      give the project its OWN engine: a full clone pulled into
#                                      <project>/engine, independent of this checkout
#   toyhub install                     symlink toyhub into ~/.local/bin
#   toyhub app [DEST]                  macOS: write "toyengine Hub.app" (default ~/Applications)
#
# ENGINE OPTIONS, accepted by new and add, pick one of the three ways a project gets its engine
# (the same three the hub offers). Each has a command of its own that switches a project that
# already exists, above:
#
#   --link [ENGINE_DIR]   share a checkout -- this one unless another is named. The default.
#   --worktree [BRANCH]   its own git worktree of this checkout, in <project>/engine, on a new
#                         branch named after the project unless BRANCH says otherwise
#   --own                 its own clone, pulled into <project>/engine
#   --branch B            worktree / own: the engine branch this project's engine work goes on
#   --ref R               the commit, tag or branch the engine starts at
#   --path P              worktree / own: where in the project the engine goes (default engine)
#
# The engine this script belongs to is the checkout it lives in (tools/..). Projects record
# git@github.com:cooparobla/toyengine.git (public) as engine.source. Three engine modes, all
# driven by the .toy file's engine: block and all materialised by the project's setup.sh:
#
#   linked    link: <abs>           .libs/toyengine symlinks a shared checkout. Engine edits are
#                                   edits for every other linked project on the box.
#   worktree  link: <rel>, mode: worktree, branch: <b>
#                                   <project>/engine is a git worktree of a toyengine checkout,
#                                   on its own branch; .libs/toyengine symlinks it. Engine work
#                                   is committed on that branch, in the engine's own history,
#                                   and no other project sees it. Costs no second clone: a
#                                   worktree shares the checkout's object store.
#   own       link: <rel>, mode: own
#                                   <project>/engine is the project's own clone of engine.source
#                                   at engine.ref; .libs/toyengine symlinks it. Independent of
#                                   any checkout on this machine, which is what a project that
#                                   has to build on another one wants.
#
# Both own-engine modes put the engine in <project>/engine, which toyhub adds to the project's
# .gitignore: it is a git checkout of its own, not project content, and the .toy's engine: block
# is what records it. They are deliberately NOT placed at .libs/toyengine -- that path is
# ./clean.sh --all's to delete.
#
# Switching between the modes is ONE step. link, worktree and own each dismantle the mode the
# project is in now before setting up the new one: an engine worktree (removed from its owning
# checkout's worktree list; its branch and commits stay), an own clone, a pinned clone in
# .libs/, an engine left over as a git submodule by an older toyhub, a stale .libs/toyengine
# symlink, and the build trees whose CMake cache remembers the old engine path. Uncommitted
# engine work stops the switch; --force throws it away.
#
# A project's name is always its folder's name. The project list is ~/.toyengine/projects.yaml
# (shared with the hub, build/toyengine_hub); only `new` and `add` put a project there --
# nothing is auto-detected -- and the engine checkout itself is never a project.
set -euo pipefail

TOY_ENGINE_SOURCE="git@github.com:cooparobla/toyengine.git"
TOY_ENGINE_SUBDIR="engine"      # where an own engine (worktree or clone) goes inside a project

# Resolve symlinks (toyhub install) to find the engine checkout.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _t="$(readlink "$_self")"
    [[ "$_t" = /* ]] && _self="$_t" || _self="$(dirname "$_self")/$_t"
done
ENGINE_DIR="$(cd "$(dirname "$_self")/.." && pwd)"
TEMPLATE_DIR="$ENGINE_DIR/templates/project"
HUB_HOME="$HOME/.toyengine"
REGISTRY="$HUB_HOME/projects.yaml"

for _p in /opt/homebrew/bin /usr/local/bin; do
    if [[ -d "$_p" && ":$PATH:" != *":$_p:"* ]]; then PATH="$_p:$PATH"; fi
done
export PATH

die()  { echo "toyhub: $*" >&2; exit 1; }
warn() { echo "toyhub: warning: $*" >&2; }
abspath() { (cd "$1" && pwd); }

is_toyengine_checkout() { [[ -f "$1/CMakeLists.txt" && -d "$1/src/toyengine" ]]; }

# engine_link <project dir> <engine dir> -- how a .toy should spell engine.link. An engine inside
# the project (a worktree or its own clone) is written project-relative so the .toy is
# committable and resolves the same on every machine; a shared checkout stays absolute.
engine_link() {
    local proj eng
    proj="$(abspath "$1")"; eng="$(abspath "$2")"
    if [[ "$eng" == "$proj"/* ]]; then echo "${eng#"$proj"/}"; else echo "$eng"; fi
}

# branch_name <project name> -- a git branch name from a project's folder name.
branch_name() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's|[^a-z0-9._/-]+|-|g; s|^[-./]+||; s|[-./]+$||'; }

# The leading comment block of this file, up to the first line of code, is the help text.
usage() { awk 'NR > 1 { if (!/^#/) exit; sub(/^#[[:space:]]?/, ""); print }' "$ENGINE_DIR/tools/toyhub"; }

# --- .toy access (same flat-YAML reader as a project's .toyenv.sh) ---------------------------

toy_file() { ls "$1"/*.toy 2>/dev/null | head -n 1 || true; }

toy_get() {   # toy_get <file> <key | section.key>
    awk -v want="$2" '
        /^[[:space:]]*#/ { next }
        {
            line = $0
            sub(/[[:space:]]+#.*$/, "", line)
            if (line ~ /^[[:space:]]*$/) next
            match(line, /^ */); ind = RLENGTH
            body = substr(line, ind + 1)
            c = index(body, ":"); if (c == 0) next
            key = substr(body, 1, c - 1)
            val = substr(body, c + 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
            gsub(/^["\047]|["\047]$/, "", val)
            if (ind == 0) { sect = key; full = key } else { full = sect "." key }
            if (full == want) { print val; exit }
        }' "$1"
}

# Rewrites the .toy's engine: block (everything else is kept verbatim).
toy_set_engine() {   # toy_set_engine <file> <source> <ref> <link> <mode> <branch>
    local f="$1" src="$2" ref="$3" link="$4" mode="${5:-}" branch="${6:-}" tmp
    tmp="$(mktemp)"
    awk -v src="$src" -v ref="$ref" -v link="$link" -v mode="$mode" -v branch="$branch" '
        function block() {
            print "engine:"
            print "  source: " src
            print "  ref: " ref "                    # commit, tag or branch the engine is checked out at"
            if (link ~ /^\//) print "  link: " link "   # shared checkout: .libs/toyengine is a symlink to it, ref unused"
            else if (link != "") print "  link: " link "                    # the project'\''s own engine: .libs/toyengine symlinks it"
            if (mode != "") print "  mode: " mode "                 # linked | worktree | own (how ./setup.sh materialises link)"
            if (branch != "") print "  branch: " branch "              # the engine branch this project'\''s engine work goes on"
            done = 1
        }
        /^engine:/ { block(); skip = 1; next }
        skip && /^[^[:space:]#]/ { skip = 0 }
        skip { next }
        { print }
        END { if (!done) block() }' "$f" > "$tmp"
    mv "$tmp" "$f"
}

project_dir() {   # project_dir <dir or registered name>
    local d="${1:-.}"
    if [[ ! -d "$d" ]]; then
        local p
        while IFS= read -r p; do
            [[ -n "$p" && -d "$p" ]] || continue
            if [[ "$(basename "$p")" == "$d" ]]; then echo "$p"; return; fi
        done < <(all_projects)
        die "no project '$d'"
    fi
    d="$(abspath "$d")"
    [[ -n "$(toy_file "$d")" ]] || die "$d has no .toy project file"
    echo "$d"
}

# --- project list (~/.toyengine/projects.yaml; the hub's hub_core.h reads/writes the same form) ---

registry_read() {   # one path per line
    [[ -f "$REGISTRY" ]] || return 0
    awk '/^[[:space:]]*-[[:space:]]/ { sub(/^[[:space:]]*-[[:space:]]*/, ""); sub(/^"/, ""); sub(/"[[:space:]]*$/, ""); gsub(/\\"/, "\""); print }' "$REGISTRY"
}
registry_write() {   # paths on stdin
    mkdir -p "$HUB_HOME"
    local tmp; tmp="$(mktemp)"
    {
        echo "# Projects listed by the toyengine hub and tools/toyhub (add / new / forget)."
        echo "projects:"
        local p
        while IFS= read -r p; do [[ -n "$p" ]] && printf '  - "%s"\n' "${p//\"/\\\"}"; done
    } > "$tmp"
    mv "$tmp" "$REGISTRY"
}
is_engine_checkout() { [[ "$(cd "$1" 2>/dev/null && pwd -P)" == "$(cd "$ENGINE_DIR" && pwd -P)" ]]; }
register() {
    is_engine_checkout "$1" && die "$1 is the engine checkout, not a project"
    { registry_read; echo "$1"; } | awk 'NF && !seen[$0]++' | registry_write
}
forget() { registry_read | grep -vxF "$1" | registry_write || true; }
all_projects() { registry_read | awk 'NF && !seen[$0]++'; }

# engine_mode <project dir> -- linked | worktree | own | pinned, from the .toy. A .toy written
# before mode: existed is read from its link: alone (absolute: linked, relative: own, none:
# pinned, the clone in .libs/ that only an older toyhub produced).
engine_mode() {
    local f; f="$(toy_file "$1")"
    [[ -n "$f" ]] || { echo pinned; return; }
    local mode link
    mode="$(toy_get "$f" engine.mode)"
    if [[ -n "$mode" ]]; then echo "$mode"; return; fi
    link="$(toy_get "$f" engine.link)"
    if [[ -z "$link" ]]; then echo pinned
    elif [[ "$link" == /* ]]; then echo linked
    else echo own; fi
}

engine_desc() {   # one-line engine description of a project dir
    local f; f="$(toy_file "$1")"
    [[ -n "$f" ]] || { echo "(no .toy)"; return; }
    local link ref branch mode
    link="$(toy_get "$f" engine.link)"; ref="$(toy_get "$f" engine.ref)"
    branch="$(toy_get "$f" engine.branch)"; mode="$(engine_mode "$1")"
    case "$mode" in
        linked)   echo "linked: $link" ;;
        worktree) echo "worktree: $link${branch:+ ($branch)}" ;;
        own)      echo "own: $link${branch:+ ($branch)}" ;;
        *)        if [[ -n "$ref" ]]; then echo "${ref:0:12}"; else echo "(no engine pin)"; fi ;;
    esac
}

# --- engine mode transitions ------------------------------------------------------------------
#
# A project is in exactly one engine mode (linked / worktree / own, see the header), and each
# leaves different things behind. engine_prepare() takes the project down to nothing but what the
# mode it is switching TO needs, so none of link / worktree / own can leave a project half in its
# old mode -- an engine worktree still registered with the checkout that owns it, a clone whose
# unpushed commits nothing else holds, a dangling .libs/toyengine, or a build tree configured
# against another engine path.

# engine_dirty <checkout> -- uncommitted work in a git checkout, one path per line (empty when
# clean or not a repository). Untracked files count: they are engine work that nothing else
# holds a copy of.
engine_dirty() { git -C "$1" status --porcelain --ignore-submodules=dirty 2>/dev/null || true; }

# engine_unpushed <checkout> -- up to five commits in it that no remote-tracking ref holds.
engine_unpushed() { git -C "$1" log --oneline --max-count=5 HEAD --branches --not --remotes 2>/dev/null || true; }

# worktree_owner <path> -- the checkout a git worktree belongs to (empty when <path> is not one).
# A worktree's .git is a file pointing into <owner>/.git/worktrees/<name>, which is what tells it
# apart from an ordinary clone (and from a submodule, whose gitdir is under .git/modules/).
worktree_owner() {
    local p="$1" common
    [[ -f "$p/.git" ]] || return 0
    common="$(git -C "$p" rev-parse --git-common-dir 2>/dev/null || true)"
    [[ -n "$common" ]] || return 0
    [[ "$common" = /* ]] || common="$(cd "$p" && cd "$common" && pwd)"
    [[ "$common" != "$(git -C "$p" rev-parse --absolute-git-dir 2>/dev/null)" ]] || return 0
    (cd "$common/.." && pwd)
}

# engine_check_clean <checkout> <what> <force> -- refuse to throw away uncommitted engine work.
engine_check_clean() {
    local p="$1" what="$2" force="$3" dirty
    dirty="$(engine_dirty "$p")"
    [[ -n "$dirty" ]] || return 0
    if (( ! force )); then
        echo "$dirty" | head -n 20 >&2
        die "$what has uncommitted engine work (above); commit or discard it there, or re-run with --force to throw it away"
    fi
    warn "discarding uncommitted engine work in $what (--force)"
}

# engine_detach <dir> <sub> <force> -- remove an engine the project keeps inside itself, whether
# it is a worktree of another checkout or a clone of its own.
engine_detach() {
    local dir="$1" sub="${2%/}" force="$3" p="$dir/$sub" owner
    [[ -n "$sub" && "$sub" != /* && "$sub" != *..* ]] || die "refusing to remove engine path '$sub'"
    [[ -e "$p" ]] || return 0
    owner="$(worktree_owner "$p")"
    if [[ -n "$owner" ]]; then
        engine_check_clean "$p" "$sub" "$force"
        local branch; branch="$(git -C "$p" symbolic-ref --short -q HEAD || true)"
        echo "[toyhub] removing the engine worktree $sub (its branch${branch:+ $branch} and commits stay in $owner)"
        git -C "$owner" worktree remove --force "$p" >/dev/null 2>&1 || rm -rf "$p"
        git -C "$owner" worktree prune >/dev/null 2>&1 || true
        return
    fi
    if [[ -e "$p/.git" ]]; then
        engine_check_clean "$p" "$sub" "$force"
        local ahead; ahead="$(engine_unpushed "$p")"
        if [[ -n "$ahead" ]]; then
            if (( ! force )); then
                echo "$ahead" >&2
                die "$sub holds engine commits that are not pushed (above); push them, or re-run with --force to lose them"
            fi
            warn "losing unpushed engine commits in $sub (--force)"
        fi
    fi
    echo "[toyhub] removing the engine in $sub"
    rm -rf "$p"
}

# submodule_entries <dir> -- "name<TAB>path<TAB>url" for every stanza in <dir>/.gitmodules.
submodule_entries() {
    local gm="$1/.gitmodules"
    [[ -f "$gm" ]] || return 0
    awk '
        function flush() { if (name != "" && path != "") print name "\t" path "\t" url; name = ""; path = ""; url = "" }
        /^[[:space:]]*\[submodule[[:space:]]/ {
            flush()
            if (match($0, /"[^"]*"/)) name = substr($0, RSTART + 1, RLENGTH - 2)
            next
        }
        /^[[:space:]]*path[[:space:]]*=/ { v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); path = v; next }
        /^[[:space:]]*url[[:space:]]*=/  { v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); url = v; next }
        END { flush() }
    ' "$gm"
}

# engine_submodules <dir> <engine.link> -- "name<TAB>path" for each submodule of <dir> that holds
# an engine. toyhub no longer vendors the engine as a submodule; this finds the ones an older
# version left, so a project set up by it still switches modes in one step.
engine_submodules() {
    local dir="$1" link="${2%/}" name path url base
    while IFS=$'\t' read -r name path url; do
        [[ -n "$path" ]] || continue
        base="$(basename "${url%.git}")"
        if [[ "$base" == "toyengine" || "$path" == "$link" || ( -f "$dir/$path/CMakeLists.txt" && -d "$dir/$path/toyengine" ) ]]; then
            printf '%s\t%s\n' "$name" "$path"
        fi
    done < <(submodule_entries "$dir")
}

# engine_desubmodule <dir> <name> <path> <force> <purge> -- take an engine submodule apart: its
# worktree, its index entry, its .gitmodules stanza and its .git/config section all go. The clone
# in .git/modules/<name> is KEPT unless <purge>, because it is where commits the project never
# pushed survive.
engine_desubmodule() {
    local dir="$1" name="$2" sub="$3" force="$4" purge="$5"
    [[ -n "$sub" && "$sub" != /* && "$sub" != *..* ]] || die "refusing to remove submodule path '$sub'"
    local gitdir="$dir/.git/modules/$name"

    if [[ -e "$dir/$sub/.git" ]]; then
        engine_check_clean "$dir/$sub" "$sub" "$force"
        local ahead; ahead="$(engine_unpushed "$dir/$sub")"
        if [[ -n "$ahead" ]]; then
            if (( purge )); then
                if (( ! force )); then
                    echo "$ahead" >&2
                    die "$sub has commits that are not pushed (above); push them, or re-run with --force to lose them with --purge"
                fi
                warn "losing unpushed commits in $sub (--force --purge)"
            else
                warn "$sub has commits that are not pushed; they stay in .git/modules/$name"
            fi
        fi
    fi

    echo "[toyhub] removing the engine submodule $sub (an older toyhub vendored it)"
    # deinit first: it empties the worktree, which is what makes `git rm` on a submodule work
    # instead of refusing. Both are no-ops on a submodule that was only half added.
    git -C "$dir" submodule deinit --force -- "$sub" >/dev/null 2>&1 || true
    if git -C "$dir" ls-files --error-unmatch -- "$sub" >/dev/null 2>&1; then
        git -C "$dir" rm --force --quiet -- "$sub" >/dev/null 2>&1 \
            || git -C "$dir" rm --cached --force --quiet -- "$sub" >/dev/null 2>&1 \
            || warn "could not drop $sub from the index; remove it by hand (git rm --cached '$sub')"
    fi
    rm -rf "$dir/$sub"
    git -C "$dir" config --remove-section "submodule.$name" >/dev/null 2>&1 || true
    if [[ -f "$dir/.gitmodules" ]]; then
        git -C "$dir" config --file .gitmodules --remove-section "submodule.$name" >/dev/null 2>&1 || true
        if grep -q '^[[:space:]]*\[submodule' "$dir/.gitmodules"; then
            git -C "$dir" add -- .gitmodules >/dev/null 2>&1 || true
        else
            # Nothing left in it: an empty .gitmodules is just noise in the next commit.
            rm -f "$dir/.gitmodules"
            git -C "$dir" rm --cached --quiet --ignore-unmatch -- .gitmodules >/dev/null 2>&1 || true
        fi
    fi
    if [[ -d "$gitdir" ]]; then
        if (( purge )); then
            rm -rf "$gitdir"
            echo "[toyhub] removed the engine clone in .git/modules/$name"
        else
            echo "[toyhub] kept the engine clone in .git/modules/$name (--purge removes it)"
        fi
    fi
    echo "[toyhub] commit the removal of $sub (and .gitmodules) when you are happy with it"
}

# engine_declone <dir> <force> -- remove a clone sitting in .libs/toyengine, which is what a .toy
# with no engine.link makes setup.sh produce.
engine_declone() {
    local dir="$1" force="$2" eng="$1/.libs/toyengine"
    [[ -e "$eng" && ! -L "$eng" ]] || return 0
    engine_check_clean "$eng" ".libs/toyengine" "$force"
    echo "[toyhub] removing the engine clone in .libs/toyengine"
    rm -rf "$eng"
}

# engine_prepare <dir> <keep> <force> <purge> -- clean the project down to nothing but <keep>, a
# project-relative engine directory to spare (the worktree or clone being set up, "" for none).
engine_prepare() {
    local dir="$1" keep="${2%/}" force="$3" purge="$4"
    local f; f="$(toy_file "$dir")"
    local link; link="$(toy_get "$f" engine.link)"; link="${link%/}"

    # Engines an older toyhub vendored as submodules.
    local name sub
    while IFS=$'\t' read -r name sub; do
        [[ -n "$sub" ]] || continue
        [[ "$sub" != "$keep" ]] || continue
        engine_desubmodule "$dir" "$name" "$sub" "$force" "$purge"
    done < <(engine_submodules "$dir" "$link")

    # The engine the project keeps inside itself: the one the .toy points at, and the default
    # path, which a half-finished switch can have left behind under another .toy.
    local cand
    for cand in "$link" "$TOY_ENGINE_SUBDIR"; do
        [[ -n "$cand" && "$cand" != /* ]] || continue
        [[ "$cand" != "$keep" ]] || continue
        [[ -e "$dir/$cand" ]] || continue
        # Only ever a toyengine checkout: a project may well keep a directory of its own under
        # the default name, and that is the project's content, not an engine to throw away.
        is_toyengine_checkout "$dir/$cand" || [[ -z "$(ls -A "$dir/$cand" 2>/dev/null)" ]] || continue
        engine_detach "$dir" "$cand" "$force"
    done

    engine_declone "$dir" "$force"
    # setup.sh re-points the symlink, but one left dangling by a failed setup reads as a broken
    # project, so it goes now.
    if [[ -L "$dir/.libs/toyengine" && ! -e "$dir/.libs/toyengine" ]]; then rm -f "$dir/.libs/toyengine"; fi
    if [[ -d "$dir/build" || -n "$(ls -d "$dir"/build-* 2>/dev/null)" ]]; then
        echo "[toyhub] removing the build trees (their CMake cache remembers the old engine path)"
    fi
    rm -rf "$dir/build" "$dir"/build-*
}

# ignore_engine_path <dir> <sub> -- keep the project's own engine out of the project's history.
# It is a git checkout in its own right; the .toy's engine: block is what records it.
ignore_engine_path() {
    local dir="$1" sub="${2%/}" gi="$1/.gitignore"
    if [[ -f "$gi" ]] && grep -qx -e "/$sub/" -e "$sub/" -e "/$sub" -e "$sub" "$gi"; then return 0; fi
    printf '\n# The engine this project builds (toyhub worktree / toyhub own), a git checkout of\n# its own. The .toy file'"'"'s engine: block is what records it; ./setup.sh remakes it.\n/%s/\n' "$sub" >> "$gi"
    echo "[toyhub] added /$sub/ to .gitignore"
}

# engine_subpath <path option> -- validate a project-relative engine directory.
engine_subpath() {
    local sub="${1%/}"
    [[ -n "$sub" ]] || die "--path needs a directory"
    case "$sub" in
        /*|.libs|.libs/*) die "--path must be a project-relative directory outside .libs/ (./clean.sh --all removes that tree)" ;;
        *..*) die "--path must not leave the project" ;;
    esac
    echo "$sub"
}

# --- commands ---------------------------------------------------------------------------------

# Parses new/add options into the caller's mode/ref/branch/link/sub/setup/dir variables.
parse_project_opts() {
    while (( $# )); do
        case "$1" in
            --link)     mode=linked
                        if [[ -n "${2:-}" && "$2" != --* ]]; then link="$2"; shift 2; else link="$ENGINE_DIR"; shift; fi ;;
            --worktree) mode=worktree
                        if [[ -n "${2:-}" && "$2" != --* ]]; then branch="$2"; shift 2; else shift; fi ;;
            --own|--copy|--vendor) mode=own; shift ;;
            --branch)   branch="${2:-}"; [[ -n "$branch" ]] || die "--branch needs a name"; shift 2 ;;
            --ref)      ref="${2:-}"; [[ -n "$ref" ]] || die "--ref needs a commit, tag or branch"; shift 2 ;;
            --path)     sub="$(engine_subpath "${2:-}")"; shift 2 ;;
            --no-setup) setup=0; shift ;;
            --name) die "a project's name is its folder's name: pick the folder instead of --name" ;;
            -*) die "unknown option $1" ;;
            *)  dir="$1"; shift ;;
        esac
    done
    if [[ "$mode" == linked ]]; then
        [[ -z "$branch" ]] || die "--branch belongs to --worktree or --own: a linked project builds a checkout it shares"
    fi
}

# scaffold <dir> <ref> <link>: lays the project template into <dir> (named after it), never
# overwriting a file that already exists. The engine: block it writes is the one <link> describes;
# worktree and own mode set theirs again once the engine is in place.
scaffold() {
    local dir="$1" ref="$2" link="$3" mode="${4:-}" branch="${5:-}"
    local name; name="$(basename "$dir")"
    # CMake target / C identifier: lower-case, [a-z0-9_], not starting with a digit.
    local target
    target="$(echo "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_]+/_/g; s/^_+|_+$//g')"
    [[ -n "$target" ]] || target="game"
    if [[ "$target" =~ ^[0-9] ]]; then target="game_$target"; fi
    if [[ "$target" == "toyengine" || "$target" == toyengine_* ]]; then target="game_$target"; fi

    if [[ -n "$link" && "$link" == /* ]]; then
        [[ -n "$ref" ]] || ref="$(git -C "$link" rev-parse HEAD 2>/dev/null || echo main)"
    elif [[ -z "$ref" ]]; then
        ref="$(git -C "$ENGINE_DIR" rev-parse HEAD 2>/dev/null || echo main)"
    fi

    # A .toy without a target (the editor's minimal one) is replaced by the template's.
    local old
    for old in "$dir"/*.toy; do
        if [[ -f "$old" && -z "$(toy_get "$old" target)" ]]; then rm "$old"; fi
    done

    # Template files (dotfiles included), placeholders substituted.
    local rel out
    while IFS= read -r rel; do
        out="$dir/${rel#./}"
        if [[ "$rel" == "./project.toy" ]]; then out="$dir/$target.toy"; fi
        if [[ -e "$out" ]]; then echo "[toyhub] kept existing ${out#"$dir"/}"; continue; fi
        mkdir -p "$(dirname "$out")"
        sed -e "s|@NAME@|$name|g" -e "s|@TARGET@|$target|g" -e "s|@SOURCE@|$TOY_ENGINE_SOURCE|g" -e "s|@REF@|$ref|g" \
            "$TEMPLATE_DIR/$rel" > "$out"
        if [[ -x "$TEMPLATE_DIR/$rel" ]]; then chmod +x "$out"; fi
    done < <(cd "$TEMPLATE_DIR" && find . -type f)

    local f; f="$(toy_file "$dir")"
    toy_set_engine "$f" "$TOY_ENGINE_SOURCE" "$ref" "$link" "$mode" "$branch"
    echo "[toyhub] set up $name in $dir (engine: $mode${link:+ $link})"
}

# new_project_engine <dir> <mode> <ref> <branch> <sub> -- put the engine the options asked for in
# place. link mode is nothing but the .toy scaffold() already wrote, so setup.sh is all it takes;
# the own-engine modes make the checkout first (and run setup.sh themselves).
new_project_engine() {
    local dir="$1" mode="$2" ref="$3" branch="$4" sub="$5"
    local opts=(--path "$sub")
    [[ -z "$branch" ]] || opts+=(--branch "$branch")
    [[ -z "$ref" ]] || opts+=(--ref "$ref")
    case "$mode" in
        worktree) cmd_worktree "$dir" "${opts[@]}" ;;
        own)      cmd_own "$dir" "${opts[@]}" ;;
        *)        "$dir/setup.sh" ;;
    esac
}

cmd_new() {
    local dir="" ref="" link="$ENGINE_DIR" branch="" mode="linked" sub="$TOY_ENGINE_SUBDIR" setup=1
    parse_project_opts "$@"
    [[ -n "$dir" ]] || die "usage: toyhub new <dir> [--link [ENGINE_DIR] | --worktree [BRANCH] | --own]"
    if [[ -e "$dir" && -n "$(ls -A "$dir" 2>/dev/null)" ]]; then die "$dir exists and is not empty (use: toyhub add $dir)"; fi
    mkdir -p "$dir"
    dir="$(abspath "$dir")"
    [[ "$mode" == linked ]] || link="$sub"
    if [[ "$mode" == linked ]]; then
        [[ -d "$link" ]] || die "no such engine checkout: $link"
        is_toyengine_checkout "$link" || die "$link is not a toyengine checkout"
        link="$(engine_link "$dir" "$link")"
    fi
    if ! (scaffold "$dir" "$ref" "$link" "$mode" "$branch"); then rmdir "$dir" 2>/dev/null || true; exit 1; fi
    register "$dir"
    if (( setup )); then new_project_engine "$dir" "$mode" "$ref" "$branch" "$sub"
    else echo "[toyhub] the engine is not in place yet: run ./setup.sh$([[ "$mode" == linked ]] || echo " (or 'toyhub $mode $dir')")"; fi
    echo "[toyhub] next: cd \"$dir\" && ./build.sh && ./editor.sh"
}

cmd_add() {
    local dir="" ref="" link="$ENGINE_DIR" branch="" mode="linked" sub="$TOY_ENGINE_SUBDIR" setup=1
    parse_project_opts "$@"
    [[ -n "$dir" ]] || die "usage: toyhub add <dir> [--link [ENGINE_DIR] | --worktree [BRANCH] | --own]"
    [[ -d "$dir" ]] || die "$dir is not a folder"
    dir="$(abspath "$dir")"
    is_engine_checkout "$dir" && die "$dir is the engine checkout, not a project"
    local f; f="$(toy_file "$dir")"
    if [[ -n "$f" && -n "$(toy_get "$f" target)" ]]; then
        register "$dir"
        echo "[toyhub] added $(basename "$dir") ($dir)"
        return
    fi
    # No project file yet: set the folder up as a new project around whatever it holds.
    [[ "$mode" == linked ]] || link="$sub"
    if [[ "$mode" == linked ]]; then
        [[ -d "$link" ]] || die "no such engine checkout: $link"
        is_toyengine_checkout "$link" || die "$link is not a toyengine checkout"
        link="$(engine_link "$dir" "$link")"
    fi
    scaffold "$dir" "$ref" "$link" "$mode" "$branch"
    register "$dir"
    if (( setup )); then new_project_engine "$dir" "$mode" "$ref" "$branch" "$sub"
    else echo "[toyhub] the engine is not in place yet: run ./setup.sh$([[ "$mode" == linked ]] || echo " (or 'toyhub $mode $dir')")"; fi
    echo "[toyhub] added $(basename "$dir") ($dir) -- next: ./build.sh && ./editor.sh"
}

# Moves <path> to the user's Trash (macOS ~/.Trash, freedesktop ~/.local/share/Trash), so a
# deleted project can be put back. Falls back to rm -rf only where there is no Trash.
move_to_trash() {
    local src="$1" trash=""
    if [[ "$(uname -s)" == Darwin ]]; then trash="$HOME/.Trash"
    elif [[ -n "${XDG_DATA_HOME:-}" || -d "$HOME/.local/share" ]]; then trash="${XDG_DATA_HOME:-$HOME/.local/share}/Trash/files"; fi
    if [[ -z "$trash" ]]; then rm -rf "$src"; echo "[toyhub] deleted $src"; return; fi
    mkdir -p "$trash"
    local name dest; name="$(basename "$src")"; dest="$trash/$name"
    if [[ -e "$dest" ]]; then dest="$trash/$name $(date +%H.%M.%S)"; fi
    mv "$src" "$dest"
    echo "[toyhub] moved $src to the Trash ($dest)"
}

cmd_delete() {
    local dir="" yes=0
    while (( $# )); do
        case "$1" in --yes|-y) yes=1; shift ;; -*) die "delete: unknown option $1" ;; *) dir="$1"; shift ;; esac
    done
    [[ -n "$dir" ]] || die "usage: toyhub delete <dir> [--yes]"
    [[ -d "$dir" ]] || { forget "$(abspath "$(dirname "$dir")")/$(basename "$dir")"; die "$dir does not exist (removed from the list)"; }
    dir="$(abspath "$dir")"
    is_engine_checkout "$dir" && die "$dir is the engine checkout, not a project"
    [[ -n "$(toy_file "$dir")" ]] || die "$dir has no .toy project file; refusing to delete it"
    if (( ! yes )); then
        read -r -p "Move $dir to the Trash? [y/N] " reply
        [[ "$reply" == [yY]* ]] || { echo "[toyhub] cancelled"; return; }
    fi
    # An engine worktree is registered with the checkout that owns it, and a folder that has
    # moved to the Trash leaves that registration pointing nowhere. The branch and its commits
    # stay in that checkout either way. A linked engine is only a symlink: nothing to do.
    local link owner; link="$(toy_get "$(toy_file "$dir")" engine.link)"
    if [[ -n "$link" && "$link" != /* ]]; then
        owner="$(worktree_owner "$dir/${link%/}")"
        if [[ -n "$owner" ]]; then
            local branch; branch="$(git -C "$dir/${link%/}" symbolic-ref --short -q HEAD || true)"
            git -C "$owner" worktree remove --force "$dir/${link%/}" >/dev/null 2>&1 || true
            git -C "$owner" worktree prune >/dev/null 2>&1 || true
            echo "[toyhub] removed the engine worktree $link${branch:+ (branch $branch stays in $owner)}"
        fi
    fi
    move_to_trash "$dir"
    forget "$dir"
}

cmd_list() {
    local porcelain=0
    if [[ "${1:-}" == "--porcelain" ]]; then porcelain=1; fi
    local p
    while IFS= read -r p; do
        [[ -d "$p" ]] || continue
        local name; name="$(basename "$p")"
        [[ -n "$(toy_file "$p")" ]] || continue
        if (( porcelain )); then printf '%s\t%s\t%s\n' "$name" "$p" "$(engine_desc "$p")"
        else printf '%-24s %-52s %s\n' "$name" "$p" "$(engine_desc "$p")"; fi
    done < <(all_projects)
}

cmd_script() {   # cmd_script <script> <dir> [args...]
    local script="$1" dir; dir="$(project_dir "${2:-.}")"; shift 2 || shift $#
    register "$dir"
    exec "$dir/$script.sh" "$@"
}

cmd_open() {
    local dir; dir="$(project_dir "${1:-.}")"
    register "$dir"
    local f target; f="$(toy_file "$dir")"; target="$(toy_get "$f" target)"
    if [[ ! -x "$dir/build/${target}_editor" ]]; then "$dir/build.sh"; fi
    mkdir -p "$dir/.toyeditor"
    # Detached: the editor outlives this script (and the hub that may have run it).
    nohup "$dir/editor.sh" > "$dir/.toyeditor/editor.log" 2>&1 < /dev/null &
    echo "[toyhub] editor started for $dir (log: .toyeditor/editor.log)"
}

cmd_rebuild() {   # for a broken build (stale CMake cache, moved engine): start from scratch
    local dir; dir="$(project_dir "${1:-.}")"
    register "$dir"
    echo "[toyhub] removing $dir/build and $dir/build-*"
    rm -rf "$dir/build" "$dir"/build-*
    "$dir/build.sh"
}

# Moves a project's own engine to another ref. A linked project has nothing to move (the checkout
# it shares is moved with git, where every other linked project sees it too), and a worktree is a
# branch, which is moved by committing on it.
cmd_upgrade() {
    local dir="" ref=""
    while (( $# )); do
        case "$1" in --ref) ref="${2:-}"; [[ -n "$ref" ]] || die "--ref needs a commit, tag or branch"; shift 2 ;; *) dir="$1"; shift ;; esac
    done
    dir="$(project_dir "${dir:-.}")"
    local f mode; f="$(toy_file "$dir")"; mode="$(engine_mode "$dir")"
    case "$mode" in
        linked)   die "$(basename "$dir") shares the checkout $(toy_get "$f" engine.link); move that with git, or give the project an engine of its own ('toyhub worktree $dir' / 'toyhub own $dir')" ;;
        worktree) die "$(basename "$dir") builds its own engine worktree in $(toy_get "$f" engine.link), on branch $(toy_get "$f" engine.branch); move it with git there" ;;
    esac
    [[ -n "$ref" ]] || ref="$(git -C "$ENGINE_DIR" rev-parse HEAD)"
    local link; link="$(toy_get "$f" engine.link)"; link="${link%/}"
    if [[ "$mode" == pinned ]]; then
        # No engine of its own: ./setup.sh fetches engine.ref into .libs/toyengine.
        toy_set_engine "$f" "$(toy_get "$f" engine.source)" "$ref" "" "" ""
        echo "[toyhub] $(basename "$f"): engine.ref = $ref"
        "$dir/setup.sh"
        return
    fi
    [[ -n "$link" && -d "$dir/$link" ]] || die "$(basename "$dir") has no engine in $link yet; run ./setup.sh first"
    engine_check_clean "$dir/$link" "$link" 0
    git -C "$dir/$link" fetch --quiet --tags origin || warn "fetch failed (offline?); using what is cloned"
    engine_checkout "$dir/$link" "$ref"
    local at; at="$(git -C "$dir/$link" symbolic-ref --short -q HEAD || git -C "$dir/$link" rev-parse HEAD)"
    toy_set_engine "$f" "$(toy_get "$f" engine.source)" "$at" "$link" own "$(toy_get "$f" engine.branch)"
    echo "[toyhub] $(basename "$f"): engine.ref = $at"
    "$dir/setup.sh"
}

# engine_checkout <checkout> <ref> -- put a checkout on a branch, tag or commit. `git checkout` on
# an unknown name reports it as a bad pathspec, which reads like a git bug rather than a missing
# ref, so the name is resolved first.
engine_checkout() {
    local p="$1" ref="$2"
    if git -C "$p" show-ref --verify --quiet "refs/remotes/origin/$ref"; then
        git -C "$p" checkout --quiet -B "$ref" "origin/$ref"          # a branch: track it
    elif git -C "$p" show-ref --verify --quiet "refs/heads/$ref"; then
        git -C "$p" checkout --quiet "$ref"
    elif git -C "$p" rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
        git -C "$p" checkout --quiet --detach "$ref"
    else
        die "engine ref '$ref' is not a branch, tag or commit in $p (fetched? pushed?)"
    fi
}

# Points the project at a toyengine checkout it shares with every other linked project on the box
# (the default, and the default checkout is this one). Whatever mode the project was in is taken
# apart first, so worktree -> linked is this one command.
cmd_link() {
    local dir="" eng="" force=0 purge=0
    while (( $# )); do
        case "$1" in
            --force|-f) force=1; shift ;;
            --purge)    purge=1; shift ;;
            -*)         die "link: unknown option $1" ;;
            *)          if [[ -z "$dir" ]]; then dir="$1"; else eng="$1"; fi; shift ;;
        esac
    done
    dir="$(project_dir "${dir:-.}")"
    eng="${eng:-$ENGINE_DIR}"
    [[ -d "$eng" ]] || die "no such engine checkout: $eng"
    is_toyengine_checkout "$eng" || die "$eng is not a toyengine checkout"
    eng="$(engine_link "$dir" "$eng")"
    local f; f="$(toy_file "$dir")"
    local src ref; src="$(toy_get "$f" engine.source)"; ref="$(toy_get "$f" engine.ref)"
    # A link target inside the project is the one engine engine_prepare must not remove.
    local keep=""; if [[ "$eng" != /* ]]; then keep="$eng"; fi
    engine_prepare "$dir" "$keep" "$force" "$purge"
    toy_set_engine "$f" "${src:-$TOY_ENGINE_SOURCE}" "${ref:-main}" "$eng" linked ""
    "$dir/setup.sh"
}

# Gives a project its own engine without a second clone: a git worktree of a toyengine checkout
# (this one by default) at <dir>/engine, on a branch of its own -- the project's name unless
# --branch says otherwise. .libs/toyengine symlinks it, so the project builds the tree it edits,
# and engine commits land on that branch in the checkout's own history, where they are pushed and
# merged like any other branch. No other project sees them until they are.
cmd_worktree() {
    local dir="" branch="" ref="" sub="$TOY_ENGINE_SUBDIR" eng="$ENGINE_DIR" force=0 purge=0
    while (( $# )); do
        case "$1" in
            --branch|-b) branch="${2:-}"; [[ -n "$branch" ]] || die "--branch needs a name"; shift 2 ;;
            --ref)       ref="${2:-}"; [[ -n "$ref" ]] || die "--ref needs a commit, tag or branch"; shift 2 ;;
            --path)      sub="$(engine_subpath "${2:-}")"; shift 2 ;;
            --from)      eng="${2:-}"; [[ -n "$eng" ]] || die "--from needs a toyengine checkout"; shift 2 ;;
            --force|-f)  force=1; shift ;;
            --purge)     purge=1; shift ;;
            -*)          die "worktree: unknown option $1" ;;
            *)           dir="$1"; shift ;;
        esac
    done
    dir="$(project_dir "${dir:-.}")"
    local f; f="$(toy_file "$dir")"
    is_toyengine_checkout "$eng" || die "$eng is not a toyengine checkout"
    [[ -e "$eng/.git" ]] || die "$eng is not a git repository -- an engine worktree is a branch of one"
    eng="$(abspath "$eng")"
    [[ -n "$branch" ]] || branch="$(branch_name "$(basename "$dir")")"
    [[ -n "$branch" ]] || die "could not make a branch name from $(basename "$dir"); pass --branch"

    # An engine already in the right place is kept: re-running this only re-points the .toy.
    local keep=""
    if [[ "$(worktree_owner "$dir/$sub")" == "$eng" ]]; then keep="$sub"; fi
    engine_prepare "$dir" "$keep" "$force" "$purge"

    if [[ -z "$keep" ]]; then
        mkdir -p "$(dirname "$dir/$sub")"
        if git -C "$eng" show-ref --verify --quiet "refs/heads/$branch"; then
            # One branch, one worktree: git refuses a second checkout of it, so say which has it.
            local held; held="$(git -C "$eng" worktree list --porcelain | awk -v b="refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0 == "branch " b {print w; exit}')"
            [[ -z "$held" ]] || die "branch '$branch' is already checked out at $held; pass --branch <other name>"
            [[ -z "$ref" ]] || warn "branch '$branch' exists: $sub starts at its tip, not at $ref"
            echo "[toyhub] adding $sub as a worktree of $eng on the existing branch $branch"
            git -C "$eng" worktree add "$dir/$sub" "$branch"
        else
            echo "[toyhub] adding $sub as a worktree of $eng on a new branch $branch${ref:+, from $ref}"
            git -C "$eng" worktree add -b "$branch" "$dir/$sub" ${ref:+"$ref"}
        fi
    else
        echo "[toyhub] kept the engine worktree in $sub"
        if [[ -n "$ref" ]]; then engine_checkout "$dir/$sub" "$ref"; fi
        # The branch recorded is the one the worktree is actually on.
        local on; on="$(git -C "$dir/$sub" symbolic-ref --short -q HEAD || true)"
        if [[ -n "$on" ]]; then branch="$on"; fi
    fi

    ignore_engine_path "$dir" "$sub"
    local src at; src="$(toy_get "$f" engine.source)"
    at="$(git -C "$dir/$sub" symbolic-ref --short -q HEAD || git -C "$dir/$sub" rev-parse HEAD)"
    toy_set_engine "$f" "${src:-$TOY_ENGINE_SOURCE}" "$at" "$(engine_link "$dir" "$dir/$sub")" worktree "$branch"
    "$dir/setup.sh"
    echo "[toyhub] $(basename "$dir") builds its own engine worktree in $sub, on branch $branch"
    echo "[toyhub] engine work is committed in $sub and pushed from there like any other branch"
}

# Gives a project its own engine as a full clone at <dir>/engine, independent of every checkout on
# this machine -- what a project that has to build somewhere else wants. The clone is taken from
# this checkout when there is one (fast, and it brings commits that are not pushed yet) with
# origin set to engine.source, so fetching and pushing go to the public remote either way;
# --from-remote clones straight from it instead. Idempotent: an engine already in place is kept.
cmd_own() {
    local dir="" ref="" branch="" sub="$TOY_ENGINE_SUBDIR" from_remote=0 force=0 purge=0
    while (( $# )); do
        case "$1" in
            --ref)        ref="${2:-}"; [[ -n "$ref" ]] || die "--ref needs a commit, tag or branch"; shift 2 ;;
            --branch|-b)  branch="${2:-}"; [[ -n "$branch" ]] || die "--branch needs a name"; shift 2 ;;
            --path)       sub="$(engine_subpath "${2:-}")"; shift 2 ;;
            --from-remote) from_remote=1; shift ;;
            --force|-f)   force=1; shift ;;
            --purge)      purge=1; shift ;;
            -*)           die "own: unknown option $1" ;;
            *)            dir="$1"; shift ;;
        esac
    done
    dir="$(project_dir "${dir:-.}")"
    local f; f="$(toy_file "$dir")"
    local src; src="$(toy_get "$f" engine.source)"; src="${src:-$TOY_ENGINE_SOURCE}"

    # An engine already cloned there is kept (a worktree is not one: that is another mode).
    local keep=""
    if [[ -e "$dir/$sub/.git" && -z "$(worktree_owner "$dir/$sub")" ]]; then keep="$sub"; fi
    engine_prepare "$dir" "$keep" "$force" "$purge"

    if [[ -n "$keep" ]]; then
        echo "[toyhub] kept the engine clone in $sub"
    else
        mkdir -p "$(dirname "$dir/$sub")"
        if (( ! from_remote )) && [[ -e "$ENGINE_DIR/.git" ]]; then
            echo "[toyhub] cloning $sub from $ENGINE_DIR (its objects are shared, and its unpushed commits come along)"
            git clone --quiet "$ENGINE_DIR" "$dir/$sub" || die "could not clone $ENGINE_DIR"
            git -C "$dir/$sub" remote set-url origin "$src"
            git -C "$dir/$sub" fetch --quiet --tags origin || warn "fetch from $src failed (offline?); the clone is complete either way"
        else
            echo "[toyhub] cloning $src into $sub"
            git clone --quiet "$src" "$dir/$sub" || die "could not clone $src"
        fi
    fi
    [[ -f "$dir/$sub/libs/libcoopa/CMakeLists.txt" ]] || warn "$sub/libs is empty: that engine checkout is incomplete"

    if [[ -n "$ref" ]]; then engine_checkout "$dir/$sub" "$ref"; fi
    if [[ -n "$branch" ]]; then
        echo "[toyhub] putting $sub on branch $branch"
        if git -C "$dir/$sub" show-ref --verify --quiet "refs/heads/$branch"; then
            git -C "$dir/$sub" checkout --quiet "$branch"
        else
            git -C "$dir/$sub" checkout --quiet -b "$branch"
        fi
    fi

    ignore_engine_path "$dir" "$sub"
    local at; at="$(git -C "$dir/$sub" symbolic-ref --short -q HEAD || git -C "$dir/$sub" rev-parse HEAD)"
    toy_set_engine "$f" "$src" "$at" "$(engine_link "$dir" "$dir/$sub")" own "$branch"
    "$dir/setup.sh"
    echo "[toyhub] $(basename "$dir") builds its own engine clone in $sub, at $at"
}

cmd_install() {
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$ENGINE_DIR/tools/toyhub" "$HOME/.local/bin/toyhub"
    echo "[toyhub] linked ~/.local/bin/toyhub -> $ENGINE_DIR/tools/toyhub"
    [[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || warn "~/.local/bin is not on PATH"
}

cmd_app() {
    [[ "$(uname -s)" == Darwin ]] || die "app: macOS only"
    local dest="${1:-$HOME/Applications}"
    local hub="$ENGINE_DIR/build/toyengine_hub"
    [[ -x "$hub" ]] || die "$hub not built -- cmake --build build --target toyengine_hub (in $ENGINE_DIR)"
    local app="$dest/toyengine Hub.app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>toyengine Hub</string>
  <key>CFBundleDisplayName</key><string>toyengine Hub</string>
  <key>CFBundleIdentifier</key><string>com.cooparobla.toyengine.hub</string>
  <key>CFBundleExecutable</key><string>toyengine-hub</string>
  <key>CFBundleIconFile</key><string>toyengine</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
    # A launcher, not a copy: the hub stays the engine checkout's build (it finds the engine,
    # themes and templates there), so rebuilding the engine updates the app.
    cat > "$app/Contents/MacOS/toyengine-hub" <<LAUNCH
#!/usr/bin/env bash
export PATH="/opt/homebrew/bin:/usr/local/bin:\$PATH"
exec "$hub" "\$@"
LAUNCH
    chmod +x "$app/Contents/MacOS/toyengine-hub"
    local icns="$ENGINE_DIR/editor/branding/toyengine.icns"
    if [[ -f "$icns" ]]; then cp "$icns" "$app/Contents/Resources/toyengine.icns"; fi
    echo "[toyhub] wrote $app"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
    new)      cmd_new "$@" ;;
    list|ls)  cmd_list "$@" ;;
    add)      cmd_add "$@" ;;
    forget)   d="$(abspath "${1:-.}")"; forget "$d"; echo "[toyhub] forgot $d" ;;
    delete)   cmd_delete "$@" ;;
    build|run|editor|package|setup|clean) cmd_script "$cmd" "$@" ;;
    open)     cmd_open "$@" ;;
    rebuild)  cmd_rebuild "$@" ;;
    upgrade)  cmd_upgrade "$@" ;;
    link)     cmd_link "$@" ;;
    worktree) cmd_worktree "$@" ;;
    own|vendor|unlink) cmd_own "$@" ;;   # vendor / unlink: the own-engine mode, under older names
    install)  cmd_install ;;
    app)      cmd_app "$@" ;;
    engine)   echo "$ENGINE_DIR" ;;
    help|-h|--help) usage ;;
    *) die "unknown command '$cmd' (toyhub help)" ;;
esac
