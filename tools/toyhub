#!/usr/bin/env bash
# toyhub -- create and manage toyengine projects from the command line (the GUI is
# build/toyengine_hub, which drives this same script).
#
#   toyhub new <dir> [--ref R | --link [ENGINE_DIR]] [--no-setup]
#                                      create <dir> as a new project (named after the folder)
#   toyhub add <dir> [same options]    list a folder as a project; one without a .toy is set up
#                                      as a new project in place first (nothing is overwritten)
#   toyhub list [--porcelain]          listed projects (porcelain: name<TAB>path<TAB>engine)
#   toyhub forget <dir>                stop listing a project (its files stay)
#   toyhub delete <dir> [--yes]        move a project's folder to the Trash and stop listing it
#   toyhub build|run|editor|package <dir> [args...]   run that project's script
#                                      (package <dir> [dev|ship|assets] [out]: Build for this platform)
#   toyhub open <dir>                  build if needed, then launch the editor detached
#   toyhub rebuild <dir>               clean rebuild: remove build output, then build.sh
#   toyhub upgrade <dir> [--ref R]     re-pin the engine (default: this checkout's HEAD)
#   toyhub link <dir> [ENGINE_DIR] [--force]
#                                      build against a local engine checkout (default: this one)
#   toyhub vendor <dir> [--ref R] [--path P] [--force] [--purge]
#                                      give the project its OWN engine: a git submodule in it
#   toyhub unlink <dir> [--force]      back to the pinned clone
#   toyhub install                     symlink toyhub into ~/.local/bin
#   toyhub app [DEST]                  macOS: write "toyengine Hub.app" (default ~/Applications)
#
# The engine this script belongs to is the checkout it lives in (tools/..). Projects pin
# git@github.com:cooparobla/toyengine.git (public) at a commit; a pinned clone can only use a
# commit that is pushed, so `new` refuses an unpushed HEAD unless --link or --ref is given.
# Three engine modes, all driven by the .toy file's engine: block:
#   pinned    engine.ref            setup.sh clones the engine into .libs/toyengine
#   linked    engine.link <abs>     .libs/toyengine symlinks a shared checkout (the default;
#                                   every project on the box builds the same working tree)
#   vendored  engine.link <rel>     the project commits its own engine as a git submodule and
#                                   .libs/toyengine symlinks that (toyhub vendor)
#
# Switching between them is ONE step. link, vendor and unlink each dismantle the mode the
# project is in now before setting up the new one: a pinned clone in .libs/, a vendored
# submodule (its worktree, .gitmodules stanza, index entry and .git/config section), a stale
# .libs/toyengine symlink and the build trees whose CMake cache remembers the old engine path.
# Uncommitted engine work stops the switch; --force throws it away. A removed submodule's
# objects stay in .git/modules/<name>, which vendoring again reuses instead of re-cloning the
# engine; --purge drops those too.
#
# A project's name is always its folder's name. The project list is ~/.toyengine/projects.yaml
# (shared with the hub, build/toyengine_hub); only `new` and `add` put a project there --
# nothing is auto-detected -- and the engine checkout itself is never a project.
set -euo pipefail

TOY_ENGINE_SOURCE="git@github.com:cooparobla/toyengine.git"

# Resolve symlinks (toyhub install) to find the engine checkout.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _t="$(readlink "$_self")"
    [[ "$_t" = /* ]] && _self="$_t" || _self="$(dirname "$_self")/$_t"
done
ENGINE_DIR="$(cd "$(dirname "$_self")/.." && pwd)"
TEMPLATE_DIR="$ENGINE_DIR/templates/project"
HUB_HOME="$HOME/.toyengine"
REGISTRY="$HUB_HOME/projects.yaml"

for _p in /opt/homebrew/bin /usr/local/bin; do
    if [[ -d "$_p" && ":$PATH:" != *":$_p:"* ]]; then PATH="$_p:$PATH"; fi
done
export PATH

die()  { echo "toyhub: $*" >&2; exit 1; }
warn() { echo "toyhub: warning: $*" >&2; }
abspath() { (cd "$1" && pwd); }

# engine_link <project dir> <engine dir> -- how a .toy should spell engine.link. An engine
# inside the project (a vendored submodule) is written project-relative so the .toy is
# committable and resolves the same on every machine; a shared checkout stays absolute.
engine_link() {
    local proj eng
    proj="$(abspath "$1")"; eng="$(abspath "$2")"
    if [[ "$eng" == "$proj"/* ]]; then echo "${eng#"$proj"/}"; else echo "$eng"; fi
}

# The leading comment block of this file, up to the first line of code, is the help text.
usage() { awk 'NR > 1 { if (!/^#/) exit; sub(/^#[[:space:]]?/, ""); print }' "$ENGINE_DIR/tools/toyhub"; }

# --- .toy access (same flat-YAML reader as a project's .toyenv.sh) ---------------------------

toy_file() { ls "$1"/*.toy 2>/dev/null | head -n 1 || true; }

toy_get() {   # toy_get <file> <key | section.key>
    awk -v want="$2" '
        /^[[:space:]]*#/ { next }
        {
            line = $0
            sub(/[[:space:]]+#.*$/, "", line)
            if (line ~ /^[[:space:]]*$/) next
            match(line, /^ */); ind = RLENGTH
            body = substr(line, ind + 1)
            c = index(body, ":"); if (c == 0) next
            key = substr(body, 1, c - 1)
            val = substr(body, c + 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
            gsub(/^["\047]|["\047]$/, "", val)
            if (ind == 0) { sect = key; full = key } else { full = sect "." key }
            if (full == want) { print val; exit }
        }' "$1"
}

# Rewrites the .toy's engine: block (everything else is kept verbatim).
toy_set_engine() {   # toy_set_engine <file> <source> <ref> <link>
    local f="$1" src="$2" ref="$3" link="$4" tmp
    tmp="$(mktemp)"
    awk -v src="$src" -v ref="$ref" -v link="$link" '
        function block() {
            print "engine:"
            print "  source: " src
            print "  ref: " ref "                    # commit, tag or branch .libs/toyengine is checked out at"
            if (link ~ /^\//) print "  link: " link "   # local checkout: .libs/toyengine is a symlink to it, ref unused"
            else if (link != "") print "  link: " link "                    # vendored submodule: .libs/toyengine is a symlink to it"
            done = 1
        }
        /^engine:/ { block(); skip = 1; next }
        skip && /^[^[:space:]#]/ { skip = 0 }
        skip { next }
        { print }
        END { if (!done) block() }' "$f" > "$tmp"
    mv "$tmp" "$f"
}

project_dir() {   # project_dir <dir or registered name>
    local d="${1:-.}"
    if [[ ! -d "$d" ]]; then
        local p
        while IFS= read -r p; do
            [[ -n "$p" && -d "$p" ]] || continue
            if [[ "$(basename "$p")" == "$d" ]]; then echo "$p"; return; fi
        done < <(all_projects)
        die "no project '$d'"
    fi
    d="$(abspath "$d")"
    [[ -n "$(toy_file "$d")" ]] || die "$d has no .toy project file"
    echo "$d"
}

# --- project list (~/.toyengine/projects.yaml; the hub's hub_core.h reads/writes the same form) ---

registry_read() {   # one path per line
    [[ -f "$REGISTRY" ]] || return 0
    awk '/^[[:space:]]*-[[:space:]]/ { sub(/^[[:space:]]*-[[:space:]]*/, ""); sub(/^"/, ""); sub(/"[[:space:]]*$/, ""); gsub(/\\"/, "\""); print }' "$REGISTRY"
}
registry_write() {   # paths on stdin
    mkdir -p "$HUB_HOME"
    local tmp; tmp="$(mktemp)"
    {
        echo "# Projects listed by the toyengine hub and tools/toyhub (add / new / forget)."
        echo "projects:"
        local p
        while IFS= read -r p; do [[ -n "$p" ]] && printf '  - "%s"\n' "${p//\"/\\\"}"; done
    } > "$tmp"
    mv "$tmp" "$REGISTRY"
}
is_engine_checkout() { [[ "$(cd "$1" 2>/dev/null && pwd -P)" == "$(cd "$ENGINE_DIR" && pwd -P)" ]]; }
register() {
    is_engine_checkout "$1" && die "$1 is the engine checkout, not a project"
    { registry_read; echo "$1"; } | awk 'NF && !seen[$0]++' | registry_write
}
forget() { registry_read | grep -vxF "$1" | registry_write || true; }
all_projects() { registry_read | awk 'NF && !seen[$0]++'; }

engine_desc() {   # one-line engine description of a project dir
    local f; f="$(toy_file "$1")"
    [[ -n "$f" ]] || { echo "(no .toy)"; return; }
    local link ref
    link="$(toy_get "$f" engine.link)"; ref="$(toy_get "$f" engine.ref)"
    if [[ -n "$link" && "$link" != /* ]]; then echo "vendored: $link"
    elif [[ -n "$link" ]]; then echo "linked: $link"
    elif [[ -n "$ref" ]]; then echo "${ref:0:12}"
    else echo "(no engine pin)"; fi
}

# --- engine mode transitions ------------------------------------------------------------------
#
# A project is in exactly one engine mode (pinned / linked / vendored, see the header), and each
# mode leaves different things behind. engine_prepare() takes the project down to nothing but
# what the mode it is switching TO needs, so none of link / vendor / unlink can leave a project
# half in its old mode -- a .gitmodules stanza for an engine that is gone, a gitlink in the
# index, a dangling .libs/toyengine, or a build tree configured against another engine path.

# engine_dirty <checkout> -- uncommitted work in a git checkout, one path per line (empty when
# clean or not a repository). Untracked files count: they are engine work that nothing else
# holds a copy of.
engine_dirty() { git -C "$1" status --porcelain --ignore-submodules=dirty 2>/dev/null || true; }

# engine_unpushed <checkout> -- up to five commits in it that no remote-tracking ref holds.
engine_unpushed() { git -C "$1" log --oneline --max-count=5 HEAD --branches --not --remotes 2>/dev/null || true; }

# submodule_entries <dir> -- "name<TAB>path<TAB>url" for every stanza in <dir>/.gitmodules.
submodule_entries() {
    local gm="$1/.gitmodules"
    [[ -f "$gm" ]] || return 0
    awk '
        function flush() { if (name != "" && path != "") print name "\t" path "\t" url; name = ""; path = ""; url = "" }
        /^[[:space:]]*\[submodule[[:space:]]/ {
            flush()
            if (match($0, /"[^"]*"/)) name = substr($0, RSTART + 1, RLENGTH - 2)
            next
        }
        /^[[:space:]]*path[[:space:]]*=/ { v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); path = v; next }
        /^[[:space:]]*url[[:space:]]*=/  { v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); url = v; next }
        END { flush() }
    ' "$gm"
}

# engine_submodules <dir> <engine.link> -- "name<TAB>path" for each submodule of <dir> that is a
# vendored engine: one cloned from a toyengine remote, one holding a toyengine checkout, or the
# one the .toy points at (which may be listed with any url, or be only half added).
engine_submodules() {
    local dir="$1" link="${2%/}" name path url base
    while IFS=$'\t' read -r name path url; do
        [[ -n "$path" ]] || continue
        base="$(basename "${url%.git}")"
        if [[ "$base" == "toyengine" || "$path" == "$link" || ( -f "$dir/$path/CMakeLists.txt" && -d "$dir/$path/toyengine" ) ]]; then
            printf '%s\t%s\n' "$name" "$path"
        fi
    done < <(submodule_entries "$dir")
}

# engine_unvendor <dir> <name> <path> <force> <purge> -- undo one `toyhub vendor`: the
# submodule's worktree, its index entry, its .gitmodules stanza and its .git/config section all
# go. The clone in .git/modules/<name> is KEPT unless <purge>, because vendoring again reuses it
# (see cmd_vendor) and because it is where commits the project never pushed survive.
engine_unvendor() {
    local dir="$1" name="$2" sub="$3" force="$4" purge="$5"
    [[ -n "$sub" && "$sub" != /* && "$sub" != *..* ]] || die "refusing to remove submodule path '$sub'"
    local gitdir="$dir/.git/modules/$name"

    if [[ -e "$dir/$sub/.git" ]]; then
        local dirty; dirty="$(engine_dirty "$dir/$sub")"
        if [[ -n "$dirty" ]]; then
            if (( ! force )); then
                echo "$dirty" | head -n 20 >&2
                die "$sub has uncommitted engine work (above); commit or discard it there, or re-run with --force to throw it away"
            fi
            warn "discarding uncommitted engine work in $sub (--force)"
        fi
        local ahead; ahead="$(engine_unpushed "$dir/$sub")"
        if [[ -n "$ahead" ]]; then
            if (( purge )); then
                if (( ! force )); then
                    echo "$ahead" >&2
                    die "$sub has commits that are not pushed (above); push them, or re-run with --force to lose them with --purge"
                fi
                warn "losing unpushed commits in $sub (--force --purge)"
            else
                warn "$sub has commits that are not pushed; they stay in .git/modules/$name"
            fi
        fi
    fi

    echo "[toyhub] removing the vendored engine submodule $sub"
    # deinit first: it empties the worktree, which is what makes `git rm` on a submodule work
    # instead of refusing. Both are no-ops on a submodule that was only half added.
    git -C "$dir" submodule deinit --force -- "$sub" >/dev/null 2>&1 || true
    if git -C "$dir" ls-files --error-unmatch -- "$sub" >/dev/null 2>&1; then
        git -C "$dir" rm --force --quiet -- "$sub" >/dev/null 2>&1 \
            || git -C "$dir" rm --cached --force --quiet -- "$sub" >/dev/null 2>&1 \
            || warn "could not drop $sub from the index; remove it by hand (git rm --cached '$sub')"
    fi
    rm -rf "$dir/$sub"
    git -C "$dir" config --remove-section "submodule.$name" >/dev/null 2>&1 || true
    if [[ -f "$dir/.gitmodules" ]]; then
        git -C "$dir" config --file .gitmodules --remove-section "submodule.$name" >/dev/null 2>&1 || true
        if grep -q '^[[:space:]]*\[submodule' "$dir/.gitmodules"; then
            git -C "$dir" add -- .gitmodules >/dev/null 2>&1 || true
        else
            # Nothing left in it: an empty .gitmodules is just noise in the next commit.
            rm -f "$dir/.gitmodules"
            git -C "$dir" rm --cached --quiet --ignore-unmatch -- .gitmodules >/dev/null 2>&1 || true
        fi
    fi
    if [[ -d "$gitdir" ]]; then
        if (( purge )); then
            rm -rf "$gitdir"
            echo "[toyhub] removed the engine clone in .git/modules/$name"
        else
            echo "[toyhub] kept the engine clone in .git/modules/$name (toyhub vendor reuses it; --purge removes it)"
        fi
    fi
    echo "[toyhub] commit the removal of $sub (and .gitmodules) when you are happy with it"
}

# engine_declone <dir> <force> -- remove a pinned clone sitting in .libs/toyengine. Only link and
# vendor mode get here; pinned mode's own setup.sh updates the clone in place.
engine_declone() {
    local dir="$1" force="$2" eng="$1/.libs/toyengine"
    [[ -e "$eng" && ! -L "$eng" ]] || return 0
    local dirty; dirty="$(engine_dirty "$eng")"
    if [[ -n "$dirty" ]]; then
        if (( ! force )); then
            echo "$dirty" | head -n 20 >&2
            die ".libs/toyengine is a pinned clone with local changes (above); commit or discard them, or re-run with --force to throw them away"
        fi
        warn "discarding local changes in the pinned clone .libs/toyengine (--force)"
    fi
    echo "[toyhub] removing the pinned engine clone in .libs/toyengine"
    rm -rf "$eng"
}

# engine_prepare <dir> <mode> <keep> <force> <purge> -- clean the project down to what <mode>
# needs. <keep> is a project-relative engine directory to spare (the submodule being vendored,
# or a link target inside the project); "" spares none.
engine_prepare() {
    local dir="$1" mode="$2" keep="${3%/}" force="$4" purge="$5"
    local f; f="$(toy_file "$dir")"
    local link; link="$(toy_get "$f" engine.link)"; link="${link%/}"

    # Every vendored engine this project has: the ones .gitmodules lists, plus the one the .toy
    # points at if a half-undone vendor left it out of .gitmodules.
    local todo=""; todo="$(engine_submodules "$dir" "$link")"
    if [[ -n "$link" && "$link" != /* && -e "$dir/$link" ]] && ! grep -q "	$link\$" <<< "$todo"; then
        todo="$(printf '%s\n%s\t%s' "$todo" "$link" "$link")"   # a leading blank line is skipped below
    fi
    local name sub
    while IFS=$'\t' read -r name sub; do
        [[ -n "$sub" ]] || continue
        [[ "$sub" != "$keep" ]] || continue
        engine_unvendor "$dir" "$name" "$sub" "$force" "$purge"
    done <<< "$todo"

    if [[ "$mode" != pinned ]]; then engine_declone "$dir" "$force"; fi
    # setup.sh re-points the symlink, but one left dangling by a failed setup reads as a broken
    # project, so it goes now.
    if [[ -L "$dir/.libs/toyengine" && ! -e "$dir/.libs/toyengine" ]]; then rm -f "$dir/.libs/toyengine"; fi
    if [[ -d "$dir/build" || -n "$(ls -d "$dir"/build-* 2>/dev/null)" ]]; then
        echo "[toyhub] removing the build trees (their CMake cache remembers the old engine path)"
    fi
    rm -rf "$dir/build" "$dir"/build-*
}

# --- commands ---------------------------------------------------------------------------------

# Parses new/add options into the caller's ref/link/setup/dir variables.
parse_project_opts() {
    while (( $# )); do
        case "$1" in
            --ref)  ref="$2"; shift 2 ;;
            --link) if [[ -n "${2:-}" && "$2" != --* ]]; then link="$2"; shift 2; else link="$ENGINE_DIR"; shift; fi ;;
            --no-setup) setup=0; shift ;;
            --name) die "a project's name is its folder's name: pick the folder instead of --name" ;;
            -*) die "unknown option $1" ;;
            *)  dir="$1"; shift ;;
        esac
    done
}

# scaffold <dir> <ref> <link>: lays the project template into <dir> (named after it), never
# overwriting a file that already exists.
scaffold() {
    local dir="$1" ref="$2" link="$3"
    local name; name="$(basename "$dir")"
    # CMake target / C identifier: lower-case, [a-z0-9_], not starting with a digit.
    local target
    target="$(echo "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_]+/_/g; s/^_+|_+$//g')"
    [[ -n "$target" ]] || target="game"
    if [[ "$target" =~ ^[0-9] ]]; then target="game_$target"; fi
    if [[ "$target" == "toyengine" || "$target" == toyengine_* ]]; then target="game_$target"; fi

    if [[ -n "$link" ]]; then
        [[ -n "$ref" ]] || ref="$(git -C "$link" rev-parse HEAD 2>/dev/null || echo main)"
        link="$(engine_link "$dir" "$link")"
    elif [[ -z "$ref" ]]; then
        ref="$(git -C "$ENGINE_DIR" rev-parse HEAD)"
        if [[ -z "$(git -C "$ENGINE_DIR" branch -r --contains "$ref" 2>/dev/null)" ]]; then
            die "this checkout's HEAD ($(git -C "$ENGINE_DIR" rev-parse --short HEAD)) is not pushed, so a clone could not check it out. Push it, pass --ref <pushed ref>, or use --link"
        fi
    fi

    # A .toy without a target (the editor's minimal one) is replaced by the template's.
    local old
    for old in "$dir"/*.toy; do
        if [[ -f "$old" && -z "$(toy_get "$old" target)" ]]; then rm "$old"; fi
    done

    # Template files (dotfiles included), placeholders substituted.
    (cd "$TEMPLATE_DIR" && find . -type f) | while IFS= read -r rel; do
        local out="$dir/${rel#./}"
        if [[ "$rel" == "./project.toy" ]]; then out="$dir/$target.toy"; fi
        if [[ -e "$out" ]]; then echo "[toyhub] kept existing ${out#$dir/}"; continue; fi
        mkdir -p "$(dirname "$out")"
        sed -e "s|@NAME@|$name|g" -e "s|@TARGET@|$target|g" -e "s|@SOURCE@|$TOY_ENGINE_SOURCE|g" -e "s|@REF@|$ref|g" \
            "$TEMPLATE_DIR/$rel" > "$out"
        if [[ -x "$TEMPLATE_DIR/$rel" ]]; then chmod +x "$out"; fi
        if [[ "$rel" == "./project.toy" ]]; then
            if [[ -n "$link" ]]; then
                sed -i.bak "s|^@LINK_LINE@$|  link: $link   # local checkout: .libs/toyengine is a symlink to it, ref unused|" "$out"
            else
                sed -i.bak '/^@LINK_LINE@$/d' "$out"
            fi
            rm -f "$out.bak"
        fi
    done
    echo "[toyhub] set up $name in $dir (engine: $([[ -n "$link" ]] && echo "linked $link" || echo "$ref"))"
}

cmd_new() {
    local dir="" ref="" link="" setup=1
    parse_project_opts "$@"
    [[ -n "$dir" ]] || die "usage: toyhub new <dir> [--ref R | --link [ENGINE_DIR]]"
    if [[ -e "$dir" && -n "$(ls -A "$dir" 2>/dev/null)" ]]; then die "$dir exists and is not empty (use: toyhub add $dir)"; fi
    mkdir -p "$dir"
    dir="$(abspath "$dir")"
    if ! (scaffold "$dir" "$ref" "$link"); then rmdir "$dir" 2>/dev/null || true; exit 1; fi
    register "$dir"
    if (( setup )); then "$dir/setup.sh"; fi
    echo "[toyhub] next: cd \"$dir\" && ./build.sh && ./editor.sh"
}

cmd_add() {
    local dir="" ref="" link="" setup=1
    parse_project_opts "$@"
    [[ -n "$dir" ]] || die "usage: toyhub add <dir> [--ref R | --link [ENGINE_DIR]]"
    [[ -d "$dir" ]] || die "$dir is not a folder"
    dir="$(abspath "$dir")"
    is_engine_checkout "$dir" && die "$dir is the engine checkout, not a project"
    local f; f="$(toy_file "$dir")"
    if [[ -n "$f" && -n "$(toy_get "$f" target)" ]]; then
        register "$dir"
        echo "[toyhub] added $(basename "$dir") ($dir)"
        return
    fi
    # No project file yet: set the folder up as a new project around whatever it holds.
    scaffold "$dir" "$ref" "$link"
    register "$dir"
    if (( setup )); then "$dir/setup.sh"; fi
    echo "[toyhub] added $(basename "$dir") ($dir) -- next: ./build.sh && ./editor.sh"
}

# Moves <path> to the user's Trash (macOS ~/.Trash, freedesktop ~/.local/share/Trash), so a
# deleted project can be put back. Falls back to rm -rf only where there is no Trash.
move_to_trash() {
    local src="$1" trash=""
    if [[ "$(uname -s)" == Darwin ]]; then trash="$HOME/.Trash"
    elif [[ -n "${XDG_DATA_HOME:-}" || -d "$HOME/.local/share" ]]; then trash="${XDG_DATA_HOME:-$HOME/.local/share}/Trash/files"; fi
    if [[ -z "$trash" ]]; then rm -rf "$src"; echo "[toyhub] deleted $src"; return; fi
    mkdir -p "$trash"
    local name dest; name="$(basename "$src")"; dest="$trash/$name"
    if [[ -e "$dest" ]]; then dest="$trash/$name $(date +%H.%M.%S)"; fi
    mv "$src" "$dest"
    echo "[toyhub] moved $src to the Trash ($dest)"
}

cmd_delete() {
    local dir="" yes=0
    while (( $# )); do
        case "$1" in --yes|-y) yes=1; shift ;; -*) die "delete: unknown option $1" ;; *) dir="$1"; shift ;; esac
    done
    [[ -n "$dir" ]] || die "usage: toyhub delete <dir> [--yes]"
    [[ -d "$dir" ]] || { forget "$(abspath "$(dirname "$dir")")/$(basename "$dir")"; die "$dir does not exist (removed from the list)"; }
    dir="$(abspath "$dir")"
    is_engine_checkout "$dir" && die "$dir is the engine checkout, not a project"
    [[ -n "$(toy_file "$dir")" ]] || die "$dir has no .toy project file; refusing to delete it"
    if (( ! yes )); then
        read -r -p "Move $dir to the Trash? [y/N] " reply
        [[ "$reply" == [yY]* ]] || { echo "[toyhub] cancelled"; return; }
    fi
    # A linked engine is only a symlink in .libs/: moving the folder never touches the checkout.
    move_to_trash "$dir"
    forget "$dir"
}

cmd_list() {
    local porcelain=0
    if [[ "${1:-}" == "--porcelain" ]]; then porcelain=1; fi
    local p
    while IFS= read -r p; do
        [[ -d "$p" ]] || continue
        local name; name="$(basename "$p")"
        [[ -n "$(toy_file "$p")" ]] || continue
        if (( porcelain )); then printf '%s\t%s\t%s\n' "$name" "$p" "$(engine_desc "$p")"
        else printf '%-24s %-52s %s\n' "$name" "$p" "$(engine_desc "$p")"; fi
    done < <(all_projects)
}

cmd_script() {   # cmd_script <script> <dir> [args...]
    local script="$1" dir; dir="$(project_dir "${2:-.}")"; shift 2 || shift $#
    register "$dir"
    exec "$dir/$script.sh" "$@"
}

cmd_open() {
    local dir; dir="$(project_dir "${1:-.}")"
    register "$dir"
    local f target; f="$(toy_file "$dir")"; target="$(toy_get "$f" target)"
    if [[ ! -x "$dir/build/${target}_editor" ]]; then "$dir/build.sh"; fi
    mkdir -p "$dir/.toyeditor"
    # Detached: the editor outlives this script (and the hub that may have run it).
    nohup "$dir/editor.sh" > "$dir/.toyeditor/editor.log" 2>&1 < /dev/null &
    echo "[toyhub] editor started for $dir (log: .toyeditor/editor.log)"
}

cmd_rebuild() {   # for a broken build (stale CMake cache, moved engine): start from scratch
    local dir; dir="$(project_dir "${1:-.}")"
    register "$dir"
    echo "[toyhub] removing $dir/build and $dir/build-*"
    rm -rf "$dir/build" "$dir"/build-*
    "$dir/build.sh"
}

cmd_upgrade() {
    local dir="" ref=""
    while (( $# )); do
        case "$1" in --ref) ref="$2"; shift 2 ;; *) dir="$1"; shift ;; esac
    done
    dir="$(project_dir "${dir:-.}")"
    local f; f="$(toy_file "$dir")"
    # A vendored engine is moved by checking the submodule out, which is cmd_vendor's job --
    # re-pinning engine.ref alone would change nothing, because setup.sh only re-links it.
    local link; link="$(toy_get "$f" engine.link)"
    if [[ -n "$link" && "$link" != /* ]]; then
        die "$(basename "$dir") vendors its engine in $link; move it with 'toyhub vendor $dir --ref <ref>'"
    fi
    [[ -n "$ref" ]] || ref="$(git -C "$ENGINE_DIR" rev-parse HEAD)"
    local src; src="$(toy_get "$f" engine.source)"
    toy_set_engine "$f" "${src:-$TOY_ENGINE_SOURCE}" "$ref" "$(toy_get "$f" engine.link)"
    echo "[toyhub] $(basename "$f"): engine.ref = $ref"
    "$dir/setup.sh"
}

# Points the project at a toyengine checkout it shares with every other project on the box
# (the default, and the default checkout is this one). Whatever mode the project was in is taken
# apart first, so vendored -> linked is this one command.
cmd_link() {
    local dir="" eng="" force=0 purge=0
    while (( $# )); do
        case "$1" in
            --force|-f) force=1; shift ;;
            --purge)    purge=1; shift ;;
            -*)         die "link: unknown option $1" ;;
            *)          if [[ -z "$dir" ]]; then dir="$1"; else eng="$1"; fi; shift ;;
        esac
    done
    dir="$(project_dir "${dir:-.}")"
    eng="${eng:-$ENGINE_DIR}"
    [[ -d "$eng" ]] || die "no such engine checkout: $eng"
    [[ -f "$eng/CMakeLists.txt" && -d "$eng/toyengine" ]] || die "$eng is not a toyengine checkout"
    eng="$(engine_link "$dir" "$eng")"
    local f; f="$(toy_file "$dir")"
    local src ref; src="$(toy_get "$f" engine.source)"; ref="$(toy_get "$f" engine.ref)"
    # A link target inside the project is the one engine engine_prepare must not remove.
    local keep=""; if [[ "$eng" != /* ]]; then keep="$eng"; fi
    engine_prepare "$dir" linked "$keep" "$force" "$purge"
    toy_set_engine "$f" "${src:-$TOY_ENGINE_SOURCE}" "${ref:-main}" "$eng"
    "$dir/setup.sh"
}

# Gives a project its own engine: a git submodule of engine.source at <dir>/<path> (engine/ by
# default), with engine.link pointing at it relative. .libs/toyengine then symlinks the
# submodule, so the project builds the copy it commits -- and because that is link mode, neither
# ./setup.sh (which only re-runs ln) nor ./clean.sh --all (which removes just .libs/) can touch
# it. A submodule records a COMMIT, not a branch, so no branch has to exist or be pushed for
# this: the clone lands on the engine's default branch and is left there. --ref moves it, and is
# the only thing that ever does -- vendoring never switches a checkout on its own. Idempotent:
# an engine already in place is kept, and only the .toy is re-pointed.
cmd_vendor() {
    local dir="" ref="" sub="engine" ref_given=0 force=0 purge=0
    while (( $# )); do
        case "$1" in
            --ref)  ref="${2:-}"; [[ -n "$ref" ]] || die "--ref needs a commit, tag or branch"; ref_given=1; shift 2 ;;
            --path) sub="${2:-}"; [[ -n "$sub" ]] || die "--path needs a directory"; shift 2 ;;
            --force|-f) force=1; shift ;;
            --purge) purge=1; shift ;;
            -*)     die "unknown option $1" ;;
            *)      dir="$1"; shift ;;
        esac
    done
    dir="$(project_dir "${dir:-.}")"
    local f; f="$(toy_file "$dir")"
    sub="${sub%/}"
    case "$sub" in
        /*|.libs|.libs/*) die "--path must be a project-relative directory outside .libs/ (./clean.sh --all removes that tree)" ;;
        *..*) die "--path must not leave the project" ;;
    esac
    [[ -e "$dir/.git" ]] || die "$(basename "$dir") is not a git repository -- a vendored engine is a submodule of the project (git init first)"
    local src; src="$(toy_get "$f" engine.source)"; src="${src:-$TOY_ENGINE_SOURCE}"

    # Take the previous mode apart (a pinned clone, a vendored engine at another --path, a link
    # elsewhere) but keep $sub, which is either already the engine or about to be.
    engine_prepare "$dir" vendored "$sub" "$force" "$purge"

    # Add it, or finish an interrupted add (a clone with no libs/ yet).
    if [[ -f "$dir/$sub/CMakeLists.txt" && -f "$dir/$sub/libs/libcoopa/CMakeLists.txt" ]]; then
        echo "[toyhub] kept existing $sub"
    else
        if [[ ! -e "$dir/$sub/.git" ]]; then
            # An interrupted or undone vendor leaves the clone behind in .git/modules/$sub with
            # no worktree, and `submodule add` then refuses outright instead of reusing it.
            # Reuse it when it is a clone of the same remote -- that saves re-cloning the whole
            # engine and its libs/ -- and refuse only when it points somewhere else, where
            # reusing would quietly vendor a different repository under the engine's name.
            local gitdir="$dir/.git/modules/$sub" force=""
            if [[ -d "$gitdir" ]]; then
                local have; have="$(git --git-dir="$gitdir" config --get remote.origin.url 2>/dev/null || true)"
                [[ "$have" == "$src" ]] || die "$dir/.git/modules/$sub is a clone of ${have:-an unknown remote}, not $src -- delete it (rm -rf '$gitdir') or vendor with --path <dir>"
                echo "[toyhub] reusing the engine clone left in .git/modules/$sub"
                force="--force"
            fi
            echo "[toyhub] adding $sub to $(basename "$dir") as a submodule of $src"
            git -C "$dir" submodule add ${force:+"$force"} "$src" "$sub"
        fi
        # Two calls, not one: `submodule add` leaves $sub already checked out, so an outer
        # `submodule update` has nothing to do for it and never descends into its own
        # submodules -- which is the whole of the engine's libs/ tree, without which configure
        # fails outright. Running it again from inside $sub populates them. Both are no-ops
        # when already done.
        echo "[toyhub] initialising $sub and its libs/ submodules"
        git -C "$dir" submodule update --init -- "$sub"
        git -C "$dir/$sub" submodule update --init --recursive
    fi

    # Only an explicit --ref moves the engine. Verify it first: `git checkout` on an unknown
    # name reports it as a bad pathspec, which reads like a git bug rather than a missing ref.
    if (( ref_given )); then
        git -C "$dir/$sub" fetch --quiet --tags origin || warn "fetch failed (offline?); using what is cloned"
        if git -C "$dir/$sub" show-ref --verify --quiet "refs/remotes/origin/$ref"; then
            git -C "$dir/$sub" checkout -B "$ref" "origin/$ref"          # a branch: track it
        elif git -C "$dir/$sub" rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
            git -C "$dir/$sub" checkout --detach "$ref"
        else
            die "engine ref '$ref' is not a branch, tag or commit in $src (pushed?)"
        fi
        git -C "$dir/$sub" submodule update --init --recursive
    fi

    # Record what is actually checked out: the branch if HEAD is on one, else the commit.
    local at
    at="$(git -C "$dir/$sub" symbolic-ref --short -q HEAD || git -C "$dir/$sub" rev-parse HEAD)"
    toy_set_engine "$f" "$src" "$at" "$(engine_link "$dir" "$dir/$sub")"
    "$dir/setup.sh"
    echo "[toyhub] $(basename "$dir") builds its own engine in $sub, at $at"
    echo "[toyhub] commit .gitmodules and the $sub pointer; engine work goes in $sub and is committed there"
}

# Back to the pinned clone: setup.sh fetches engine.ref into .libs/toyengine. A linked engine is
# only a symlink, but a vendored one is a submodule of the project, and that comes apart here.
cmd_unlink() {
    local dir="" force=0 purge=0
    while (( $# )); do
        case "$1" in
            --force|-f) force=1; shift ;;
            --purge)    purge=1; shift ;;
            -*)         die "unlink: unknown option $1" ;;
            *)          dir="$1"; shift ;;
        esac
    done
    dir="$(project_dir "${dir:-.}")"
    local f; f="$(toy_file "$dir")"
    local src ref; src="$(toy_get "$f" engine.source)"; ref="$(toy_get "$f" engine.ref)"
    engine_prepare "$dir" pinned "" "$force" "$purge"
    toy_set_engine "$f" "${src:-$TOY_ENGINE_SOURCE}" "${ref:-main}" ""
    if [[ -L "$dir/.libs/toyengine" ]]; then rm "$dir/.libs/toyengine"; fi
    "$dir/setup.sh"
}

cmd_install() {
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$ENGINE_DIR/tools/toyhub" "$HOME/.local/bin/toyhub"
    echo "[toyhub] linked ~/.local/bin/toyhub -> $ENGINE_DIR/tools/toyhub"
    [[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || warn "~/.local/bin is not on PATH"
}

cmd_app() {
    [[ "$(uname -s)" == Darwin ]] || die "app: macOS only"
    local dest="${1:-$HOME/Applications}"
    local hub="$ENGINE_DIR/build/toyengine_hub"
    [[ -x "$hub" ]] || die "$hub not built -- cmake --build build --target toyengine_hub (in $ENGINE_DIR)"
    local app="$dest/toyengine Hub.app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>toyengine Hub</string>
  <key>CFBundleDisplayName</key><string>toyengine Hub</string>
  <key>CFBundleIdentifier</key><string>com.cooparobla.toyengine.hub</string>
  <key>CFBundleExecutable</key><string>toyengine-hub</string>
  <key>CFBundleIconFile</key><string>toyengine</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
    # A launcher, not a copy: the hub stays the engine checkout's build (it finds the engine,
    # themes and templates there), so rebuilding the engine updates the app.
    cat > "$app/Contents/MacOS/toyengine-hub" <<LAUNCH
#!/usr/bin/env bash
export PATH="/opt/homebrew/bin:/usr/local/bin:\$PATH"
exec "$hub" "\$@"
LAUNCH
    chmod +x "$app/Contents/MacOS/toyengine-hub"
    local icns="$ENGINE_DIR/editor/branding/toyengine.icns"
    if [[ -f "$icns" ]]; then cp "$icns" "$app/Contents/Resources/toyengine.icns"; fi
    echo "[toyhub] wrote $app"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
    new)      cmd_new "$@" ;;
    list|ls)  cmd_list "$@" ;;
    add)      cmd_add "$@" ;;
    forget)   d="$(abspath "${1:-.}")"; forget "$d"; echo "[toyhub] forgot $d" ;;
    delete)   cmd_delete "$@" ;;
    build|run|editor|package|setup|clean) cmd_script "$cmd" "$@" ;;
    open)     cmd_open "$@" ;;
    rebuild)  cmd_rebuild "$@" ;;
    upgrade)  cmd_upgrade "$@" ;;
    link)     cmd_link "$@" ;;
    vendor)   cmd_vendor "$@" ;;
    unlink)   cmd_unlink "$@" ;;
    install)  cmd_install ;;
    app)      cmd_app "$@" ;;
    engine)   echo "$ENGINE_DIR" ;;
    help|-h|--help) usage ;;
    *) die "unknown command '$cmd' (toyhub help)" ;;
esac
